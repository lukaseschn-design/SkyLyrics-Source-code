{
  "schemaVersion": 1,
  "id": "lyricsflow",
  "version": "${version}",
  "name": "SkyLyrics",
  "description": "Synced live lyrics from Spotify or YouTube, glowing in the sky or floating smoothly in the air. dc: i.am.maximus",
  "authors": [
    "Maximus"
  ],
  "contact": {},
  "license": "Custom (ARR)",
  "icon": "assets/lyricsflow/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.lyricsflow.SkyLyricsClient"
    ],
    "modmenu": [
      "dev.lyricsflow.compat.ModMenuEntry"
    ]
  },
  "mixins": [
    "lyricsflow.mixins.json",
    "lumiclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.2+26.3"
  },
  "suggests": {
    "modmenu": "*"
  }
}