{
  "schemaVersion": 1,
  "id": "lyricsflow",
  "version": "${version}",
  "name": "SkyLyrics",
  "description": "Synced live lyrics from Spotify or YouTube, glowing in the sky or floating smoothly in the air. dc: i.am.maximus",
  "authors": [
    "Maximus"
  ],
  "contact": {
    "homepage": "https://github.com/lukaseschn-design/SkyLyrics-Source-code",
    "sources": "https://github.com/lukaseschn-design/SkyLyrics-Source-code",
    "issues": "https://github.com/lukaseschn-design/SkyLyrics-Source-code/issues"
  },
  "license": "Custom (ARR)",
  "icon": "assets/lyricsflow/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.lyricsflow.SkyLyricsClient"
    ],
    "modmenu": [
      "dev.lyricsflow.compat.ModMenuEntry"
    ]
  },
  "mixins": [
    "lyricsflow.mixins.json",
    "lumiclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
